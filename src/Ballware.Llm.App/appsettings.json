{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:3004"
      }
    },
    "Limits": {
      "MaxRequestLineSize": 24576,
      "MaxRequestBodySize": 40000000
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ContentSecurity": {
    "FrameAncestors": "'self'"
  },
  "Session": {
    "EnableSession": true,
    "SessionCookieName": ".Ballware.Llm.Session",
    "SessionCacheKeyPrefix": "llm:session:",
    "SessionCacheExpirationInMinutes": 60,
    "SuppressDefaultSessionCookie": true,
    "DataProtectionPurpose": "Ballware.Llm.Session.ClaimsPrincipal"
  },
  "Authorization": {
    "Authority": "https://identity.ballware.de/realms/ballware",
    "Audience": "ballwareweb",
    "ClientId": "ballwareweb",
    "RequiredUserScope": "mlApi",
    "UserScopePolicyName": "mlApi",
    "ServiceScopePolicyName": "serviceApi",
    "SignOnAllowedHosts": [],
    "SignOnAllowedRedirectPathPrefixes": [ "/chat" ],
    "RequireHttpsMetadata": true
  },
  "Llm": {
    "Provider": "postgres",
    "AutoMigrations": false
  },
  "Inference": {
    "Endpoint": "http://localhost:11434",
    "ApiKey": "replace-with-local-api-key",
    "Model": "qwen3.8"
  },
  "Embedding": {
    "Endpoint": "http://localhost:11434",
    "ApiKey": "replace-with-local-api-key",
    "Model": "embeddinggemma"
  },
  "MetaClient": {
    "ServiceUrl": "http://localhost:5001/meta",
    "CredentialIdentifier": "meta"
  },
  "StorageClient": {
    "ServiceUrl": "http://localhost:5005/storage",
    "CredentialIdentifier": "storage"
  },
  "ConnectionStrings": {
    "LlmStorageConnection": "Host=postgres;Port=5432;Database=embedding;Username=embedding;Password=ChangeMe2025!"
  },
  "AllowedHosts": "*"
}
